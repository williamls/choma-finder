# Copy to .env and fill in. Never commit .env.
# These two come from Supabase > Project Settings > API. The anon key is meant to be public
# (the database rules in supabase/schema.sql protect the data). Never put the service_role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Used to turn 0700... into +256700... when vendors type their number.
DEFAULT_COUNTRY_CODE=+256
# Step 3:
ADMIN_PASSWORD=
